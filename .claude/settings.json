{
  "$comment": "IA Engineering — Claude Code hooks (Adapters/ai-runtimes/claude-code/). Generated by install-hooks.sh from settings.example.json, which carries a placeholder for the framework's path relative to the project ('.' in the framework repository, 'ia-engineering' when imported as a submodule). The guard hooks (block-escape-hatches, block-inline-suppression) fail closed on unreadable input, and every hook is documented in hooks/README.md. The context alert (hooks/context-alert.sh, on UserPromptSubmit and PostToolBatch) never blocks: it tells the Main Agent once per step to run the Handoff checklist. The statusLine (hooks/context-statusline.sh) records the context occupancy for the context alert and runs the user's own status line, which a project statusLine would otherwise hide; install-hooks.sh wraps a project's own statusLine instead of replacing it. This file decides what the model may do: review it like code.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/./Adapters/ai-runtimes/claude-code/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/./Adapters/ai-runtimes/claude-code/hooks/context-alert.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/./Adapters/ai-runtimes/claude-code/hooks/block-escape-hatches.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/./Adapters/ai-runtimes/claude-code/hooks/block-inline-suppression.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/./Adapters/ai-runtimes/claude-code/hooks/post-edit-lint.sh\""
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/./Adapters/ai-runtimes/claude-code/hooks/context-alert.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/./Adapters/ai-runtimes/claude-code/hooks/stop-gate.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/./Adapters/ai-runtimes/claude-code/hooks/dashboard-refresh.sh\" >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/./Adapters/ai-runtimes/claude-code/hooks/context-statusline.sh\""
  }
}
