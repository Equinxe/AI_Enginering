{
  "$comment": "IA Engineering — Claude Code hooks (Adapters/ai-runtimes/claude-code/). Generated by install-hooks.sh from settings.example.json, which carries a placeholder for the framework's path relative to the project ('.' in the framework repository, 'ia-engineering' when imported as a submodule). The guard hooks (block-escape-hatches, block-inline-suppression) fail closed on unreadable input, and every hook is documented in hooks/README.md. This file decides what the model may do: review it like code.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/__IAENG_ROOT__/Adapters/ai-runtimes/claude-code/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/__IAENG_ROOT__/Adapters/ai-runtimes/claude-code/hooks/block-escape-hatches.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/__IAENG_ROOT__/Adapters/ai-runtimes/claude-code/hooks/block-inline-suppression.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/__IAENG_ROOT__/Adapters/ai-runtimes/claude-code/hooks/post-edit-lint.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/__IAENG_ROOT__/Adapters/ai-runtimes/claude-code/hooks/stop-gate.sh\""
          }
        ]
      }
    ]
  }
}
