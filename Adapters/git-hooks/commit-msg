#!/usr/bin/env bash
# IA Engineering — commit-msg hook
#
# Enforces two rules mechanically instead of relying on the AI reading and
# choosing to follow them:
#   1. Standards/COMMIT_STANDARD.md — Conventional Commits subject line.
#   2. Core/MAIN_AGENT_CONDUCT.md (Dispatch Discipline) — every commit must
#      identify the Employee who produced it, by name, not by a generic tool
#      label ("executor", "coder", etc.).
#
# The Employee roster is read from Registry/employees.yml — the single source
# of truth (see Registry/README.md). Before WU-IAENG-138 this hook carried its
# own hardcoded copy of all 42 names, which had to be kept in sync by hand with
# five other locations.
#
# Install in a project that has imported IA Engineering as a submodule:
#   ./ia-engineering/Adapters/scripts/install.sh
#
# or, to install this hook alone:
#   cp ia-engineering/Adapters/git-hooks/commit-msg .git/hooks/commit-msg
#   chmod +x .git/hooks/commit-msg
#
# Commit message format expected:
#
#   type(scope): description
#
#   [optional body]
#
#   Work Unit: WU-<project>-<number>
#
#   Employee: <Exact Employee Name>
#
# Example:
#
#   feat(tasks): add PATCH /tasks/{id}/complete endpoint
#
#   Work Unit: WU-IAENG-042
#
#   Employee: Backend Engineer

set -euo pipefail

COMMIT_MSG_FILE="$1"
SUBJECT="$(head -1 "$COMMIT_MSG_FILE")"

# --- Merge commit exception ------------------------------------------------
# Git creates MERGE_HEAD while a merge is in progress, and it still exists
# when the commit-msg hook runs for the resulting merge commit. Its subject
# line is auto-generated by git ("Merge branch 'develop' into ...", "Merge
# pull request #N from ...", or a custom message if --no-edit wasn't used)
# and can never be made to match the Conventional Commits format or carry an
# Employee trailer. Detect it via MERGE_HEAD rather than pattern-matching the
# message text, since the wording varies. Use `git rev-parse --git-path` so
# this resolves correctly inside a worktree (each worktree has its own
# MERGE_HEAD but shares a common git dir).
MERGE_HEAD_PATH="$(git rev-parse --git-path MERGE_HEAD)"

if [ -f "$MERGE_HEAD_PATH" ]; then
  exit 0
fi

# --- Rule 1: Conventional Commits subject line ---------------------------
# Types kept in sync with Templates/PULL_REQUEST.md's Type checklist.
CC_REGEX='^(feat|fix|docs|refactor|perf|test|chore)(\([a-zA-Z0-9,._-]+\))?: .+'

if ! echo "$SUBJECT" | grep -qE "$CC_REGEX"; then
  echo "commit-msg: rejected — subject line does not follow the Commit Standard." >&2
  echo "  Expected: type(scope): description" >&2
  echo "  type is one of: feat, fix, docs, refactor, perf, test, chore" >&2
  echo "  Got: $SUBJECT" >&2
  exit 1
fi

# --- Locate the Employee roster -------------------------------------------
# Resolution order, first hit wins:
#   1. $IAENG_REGISTRY            — explicit override, for non-standard layouts
#   2. <repo>/Registry/           — the framework's own repository (dogfooding)
#   3. <repo>/ia-engineering/     — the submodule path Workflows/ONBOARDING.md
#                                   and Adapters/README.md both assume
REPO_ROOT="$(git rev-parse --show-toplevel)"
ROSTER=""

for candidate in \
  "${IAENG_REGISTRY:-}" \
  "$REPO_ROOT/Registry/employees.yml" \
  "$REPO_ROOT/ia-engineering/Registry/employees.yml"
do
  if [ -n "$candidate" ] && [ -f "$candidate" ]; then
    ROSTER="$candidate"
    break
  fi
done

# Fail closed, never open. An earlier draft of this hook fell back to a
# hardcoded 42-name array when the roster could not be found, which is exactly
# the silent-degradation failure mode this framework keeps having to fix after
# the fact: the hook would keep passing while validating against a list nobody
# maintains. A missing roster is a broken installation and it says so.
if [ -z "$ROSTER" ]; then
  echo "commit-msg: rejected — could not locate Registry/employees.yml." >&2
  echo "  Looked for, in order:" >&2
  echo "    \$IAENG_REGISTRY (currently: '${IAENG_REGISTRY:-unset}')" >&2
  echo "    $REPO_ROOT/Registry/employees.yml" >&2
  echo "    $REPO_ROOT/ia-engineering/Registry/employees.yml" >&2
  echo "  The Employee roster is the single source of truth for the" >&2
  echo "  'Employee:' trailer (see Registry/README.md). Without it this hook" >&2
  echo "  cannot validate anything, and passing silently would be worse than" >&2
  echo "  failing. Import the framework, or set IAENG_REGISTRY to its path." >&2
  exit 1
fi

# --- Project roster extension: Domain Employees ---------------------------
# Templates/DOMAIN_EMPLOYEE.md lets a project define Employees for its own
# business domain. They live in the PROJECT, never in the framework's
# Employees/, and are registered in a project roster with the same parsing
# contract as Registry/employees.yml. Resolution:
#   1. $IAENG_PROJECT_ROSTER                          — explicit; a set value
#                                                       that names a missing
#                                                       file is a broken
#                                                       configuration and is
#                                                       refused, not skipped
#   2. <repo>/.ia-engineering/Registry/employees.yml  — the default location
# Absence of the default file is the ordinary case (no Domain Employees) and
# is reported in the rejection message, so a reader sees which rosters were
# consulted rather than wondering.
PROJECT_ROSTER=""
if [ -n "${IAENG_PROJECT_ROSTER:-}" ]; then
  if [ -f "$IAENG_PROJECT_ROSTER" ]; then
    PROJECT_ROSTER="$IAENG_PROJECT_ROSTER"
  else
    echo "commit-msg: rejected — IAENG_PROJECT_ROSTER is set to '$IAENG_PROJECT_ROSTER' but no such file exists." >&2
    echo "  An explicitly configured roster that cannot be read is a broken" >&2
    echo "  installation; validating against the framework roster alone would" >&2
    echo "  silently refuse every Domain Employee. Fix the path or unset it." >&2
    exit 1
  fi
elif [ -f "$REPO_ROOT/.ia-engineering/Registry/employees.yml" ]; then
  PROJECT_ROSTER="$REPO_ROOT/.ia-engineering/Registry/employees.yml"
fi

# --- Rule 2: Dispatch Discipline — Employee trailer required --------------
# Parsing contract, per Registry/README.md: every entry's first line is
# `  - name: <Name>` — two leading spaces, unquoted, no trailing comment. The
# trailing `tr -d '\r'` guards against a CRLF checkout on Windows, which would
# otherwise leave a carriage return on every name and match nothing.
# EVERY `Employee: ` line is validated, not one of them.
#
# Two earlier versions picked a single line by ordinal and both were bypassable,
# in mirror-image ways. All six cases below were reproduced against this hook:
#
#   with `head -1`  a body quoting a valid name EARLY masked a real trailer
#                   naming a tool label   -> ACCEPTED
#   with `tail -1`  a squash-concatenated message whose first block carried
#                   `Employee: executor` and whose last block carried a valid
#                   name                  -> ACCEPTED
#
# The second is the first with the sign flipped. Neither end is safe, because
# the defect was never about which end: it is about examining ONE line when the
# message contains N claims. A squashed merge is the realistic source — every
# squashed commit's body concatenates the trailer blocks of its parts.
#
# Validating all of them makes the ordinal irrelevant and closes both. It also
# converts the remaining annoyance into an honest one: a message that quotes
# this hook's own rejection text at column 0 is now refused for containing an
# unvalidated Employee line, which is true, and the fix is to indent the quoted
# example — a habit worth having.
#
# The strictly correct definition is git's own: the trailer block is the final
# paragraph when it consists entirely of trailer-shaped lines. That is not
# usable here yet, because this project's messages put `Work Unit:` and
# `Employee:` in SEPARATE paragraphs, so the final paragraph holds only one of
# them — the same separation that makes
# `git log --format='%(trailers:key=Work Unit)'` return nothing. Fixing that is
# a change to Standards/COMMIT_STANDARD.md and to the generated agent template,
# tracked as its own Work Unit.
EMPLOYEE_LINES="$(grep -E '^Employee: ' "$COMMIT_MSG_FILE" || true)"

# --- Rule 3: at most one Work Unit claim -------------------------------
# `Standards/COMMIT_STANDARD.md` and CLAUDE.md both state One Work Unit = One
# Commit. A commit carrying two `Work Unit:` lines is therefore MALFORMED, not
# ambiguous — and refusing it here is what lets every reader downstream take
# the single line with no ordinal at all.
#
# This exists because ranking by position kept producing bypasses. The release
# readiness check attributes a Work Unit to a commit, which needs one answer,
# so it took the last matching line — and a commit correctly formed under this
# Standard, with a deferral note quoted after the trailer block, silently
# flipped a blocked release to green: the quoted id was last, so it counted as
# merged. Nothing else caught it, because the quoted id was itself registered
# and so validated fine.
#
# Removing the choice is the fix, not choosing a better end. The author learns
# at commit time, locally and immediately, instead of the Release Manager
# meeting it at Step 1.
#
# CAVEAT: this assumes merge commits, not squashes. A squash-merged commit
# legitimately carries one trailer block per squashed part. This project uses
# merge commits; if squashing is ever adopted, attribution changes shape and
# this rule should be reopened deliberately rather than inherited.
WU_COUNT="$(grep -cE '^Work Unit: ' "$COMMIT_MSG_FILE" || true)"

if [ "$WU_COUNT" -gt 1 ]; then
  echo "commit-msg: rejected — $WU_COUNT 'Work Unit:' lines at column 0." >&2
  echo "  One Work Unit is one commit (Standards/COMMIT_STANDARD.md), so a" >&2
  echo "  second claim is malformed rather than something to resolve by" >&2
  echo "  position. Downstream readers rely on there being exactly one." >&2
  echo "" >&2
  echo "  If one of these is an EXAMPLE quoted in the message body — a" >&2
  echo "  deferral note, a reference to earlier work — indent it so it does" >&2
  echo "  not start at column 0." >&2
  exit 1
fi

if [ -z "$EMPLOYEE_LINES" ]; then
  echo "commit-msg: rejected — missing 'Employee: <Name>' trailer." >&2
  echo "  Per Core/MAIN_AGENT_CONDUCT.md (Dispatch Discipline), every commit must" >&2
  echo "  identify the Employee who produced it — never the Main Agent, never a" >&2
  echo "  generic tool label." >&2
  exit 1
fi

VALID_NAMES="$(grep -E '^  - name: ' "$ROSTER" | sed 's/^  - name: //' | tr -d '\r')"
if [ -n "$PROJECT_ROSTER" ]; then
  VALID_NAMES="$VALID_NAMES
$(grep -E '^  - name: ' "$PROJECT_ROSTER" | sed 's/^  - name: //' | tr -d '\r')"
fi

REJECTED=0
while IFS= read -r line; do
  [ -n "$line" ] || continue
  name="$(echo "${line#Employee: }" | tr -d '\r')"
  if ! printf '%s\n' "$VALID_NAMES" | grep -qxF "$name"; then
    echo "commit-msg: rejected — 'Employee: $name' is not a recognized Employee." >&2
    REJECTED=1
  fi
done <<EOF
$EMPLOYEE_LINES
EOF

if [ "$REJECTED" -eq 1 ]; then
  echo "  Must exactly match an entry in $ROSTER" >&2
  if [ -n "$PROJECT_ROSTER" ]; then
    echo "  or in the project roster $PROJECT_ROSTER (Templates/DOMAIN_EMPLOYEE.md)" >&2
  else
    echo "  (no project roster found at .ia-engineering/Registry/employees.yml —" >&2
    echo "  Domain Employees, if any, are registered there: Templates/DOMAIN_EMPLOYEE.md)" >&2
  fi
  echo "  A functional or tool label ('executor', 'coder', 'reviewer-bot', etc.) is not" >&2
  echo "  a valid Employee name — see Core/MAIN_AGENT_CONDUCT.md, 'Naming matters.'" >&2
  echo "" >&2
  echo "  Every line beginning 'Employee: ' is checked, not just one, because" >&2
  echo "  picking a single line by position was bypassable from whichever end" >&2
  echo "  was not chosen. If the offending line is an EXAMPLE quoted in the" >&2
  echo "  message body, indent it so it does not start at column 0." >&2
  exit 1
fi

exit 0
