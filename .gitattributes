# Adapters ship as executable scripts installed directly into other projects'
# .git/hooks/ or run as shell scripts. A CRLF line ending breaks the shebang
# line on Linux/CI even though the file still "looks fine" on Windows editors.
# Force LF regardless of the checkout platform or user's core.autocrlf setting.
/Adapters/git-hooks/* text eol=lf
/Adapters/scripts/*.sh text eol=lf
